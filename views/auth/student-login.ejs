<%- include('../layout/header', {title: 'Student Login - Islamic School', page: 'auth'}) %>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card glass-panel shadow-lg p-5">
                <div class="card-body text-center">
                    <i class="fas fa-user-graduate fa-3x text-islamic mb-4"></i>
                    <h2 class="h2 mb-4">Student Portal</h2>
                    <form action="/auth/student-login" method="POST">
                        <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                        </div>
                        <% } %>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Admission Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input type="text" name="admission_number" class="form-control" placeholder="e.g. STU2025001" value="<%= typeof admission_number !== 'undefined' ? admission_number : '' %>" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                            </div>
                        </div>
                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="remember">
                            <label class="form-check-label" for="remember">Remember me</label>
                        </div>
                        <button type="submit" class="btn btn-islamic w-100 py-3 fw-bold">
                            <i class="fas fa-sign-in-alt me-2"></i>Login to Portal
                        </button>
                        
                        <!-- Google reCAPTCHA v3 -->
                        <div class="g-recaptcha mt-3" data-sitekey="6LcG7oosAAAAAI9t2UE-HtzCRak2lBErhqo7IMZe" data-callback="onRecaptchaSuccess"></div>
                    </form>
                    <hr class="my-4">
                    <div class="text-center">
                        <p>New student? <a href="/auth/student-register" class="text-decoration-none fw-bold text-islamic">Register Now</a></p>
                        <p><a href="/student/forgot-password" class="text-decoration-none fw-bold text-warning"><i class="fas fa-key me-1"></i>Forgot Password?</a></p>
                        <p><a href="/auth/staff-login" class="text-decoration-none">Staff Login →</a></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../layout/footer') %>
